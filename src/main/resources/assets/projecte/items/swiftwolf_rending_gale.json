{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "projecte:swrg_mode",
    "cases": [
      {
        "when": "flight",
        "model": {
          "type": "minecraft:model",
          "model": "projecte:item/swiftwolf_rending_gale_fly"
        }
      },
      {
        "when": "shield",
        "model": {
          "type": "minecraft:model",
          "model": "projecte:item/swiftwolf_rending_gale_repel"
        }
      },
      {
        "when": "shielded_flight",
        "model": {
          "type": "minecraft:model",
          "model": "projecte:item/swiftwolf_rending_gale_fly_repel"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "projecte:item/swiftwolf_rending_gale"
    }
  }
}
